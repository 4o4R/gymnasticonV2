[Unit]
Description=Copy user gymnasticon.json
Before=gymnasticon.service

[Service]
# Raspbian Buster ships systemd 241, which has no ExecCondition=, so the
# boot-partition check happens in the command itself and exits 0 when there is
# no user-supplied config to copy.
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'if [ ! -f /boot/firmware/gymnasticon.json ] && [ ! -f /boot/gymnasticon.json ]; then echo "gymnasticon-mods: no gymnasticon.json on the boot partition"; exit 0; fi; src=/boot/gymnasticon.json; [ -f /boot/firmware/gymnasticon.json ] && src=/boot/firmware/gymnasticon.json; install -o pi -g pi -m 644 "$src" /etc/gymnasticon.json'

[Install]
WantedBy=multi-user.target

[Unit]
Description=Gymnasticon Bike Bridge
# The appliance only needs a working Bluetooth radio to start riding. Waiting
# for network-online.target can add minutes on a Pi with no Wi-Fi configured,
# so ordering is limited to Bluetooth and the adapter reprobe unit below.
After=bluetooth.target gymnasticon-bt-reprobe.service
Requires=bluetooth.target
Wants=gymnasticon-bt-reprobe.service
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=NODE_ENV=production
Environment=PATH=/opt/gymnasticon/node/bin:/opt/gymnasticon/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/opt/gymnasticon
ExecStart=/opt/gymnasticon/bin/gymnasticon --config /etc/gymnasticon.json
Restart=always
RestartSec=5
StandardOutput=journal+console
StandardError=journal+console
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
